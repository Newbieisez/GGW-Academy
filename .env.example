# Production values belong in the hosting provider's environment manager.
# Never commit a real API key or secret.

# Comma-separated addresses allowed to open the aggregate-only leadership view.
GGW_ADMIN_EMAILS=

# Server-side Gemini API key for /api/gemini.
GEMINI_API_KEY=

# Optional model override. The application defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
