# Production values belong in the hosting provider's environment manager.
# Never commit a real API key or secret.

# Comma-separated addresses allowed to open the aggregate-only leadership view.
GGW_ADMIN_EMAILS=

# Server-side Gemini API key for /api/gemini.
GEMINI_API_KEY=

# Optional model override. The application defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Google Drive Picker (public browser configuration, not OAuth client secret).
# Restrict the API key to the production hostname and Google Picker/Drive APIs.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Optional public URLs for the static GitHub Pages build. These are endpoint
# locations only; the endpoints must enforce Google/GGW access server-side.
# Never place a secret, API key, OAuth client secret, or service-account key
# in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_ACADEMY_API_BASE=
NEXT_PUBLIC_GEMINI_API_URL=
