{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ggw-academy",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "ggw.its-ez.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ggw-workbench-prod",
      "database_id": "29309a2c-701f-4f82-957e-61c64eb6be22",
      "migrations_dir": "drizzle"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
